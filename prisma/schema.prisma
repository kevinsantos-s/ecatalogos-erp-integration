generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Integration {
  id               BigInt   @id @default(autoincrement())

  // Bling
  blingCompanyId   String
  blingToken       String   @db.Text

  // B2B
  b2bCompanyErpId  String
  b2bToken         String   @db.Text

  createdAt        DateTime @default(now())

  @@map("integrations")
}
