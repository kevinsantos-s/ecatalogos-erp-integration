generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blingAuth BlingAuth?
  b2bAuth   B2BAuth?
  companies Company[]

  @@map("users")
}

model BlingCompany {
  id             String   @id @default(uuid())
  blingCompanyId String   @unique

  nome           String?
  cnpj           String?
  email          String?

  auth           BlingAuth?
  companies      Company[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("bling_companies")
}

model BlingAuth {
  id             String   @id @default(uuid())
  userId         String   @unique

  blingCompanyId String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  blingCompany   BlingCompany @relation(fields: [blingCompanyId], references: [blingCompanyId], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("bling_auth")
}

model B2BAuth {
  id          String   @id @default(uuid())
  userId      String   @unique

  accessToken String
  expiresAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("b2b_auth")
}

model Company {
  id              String   @id @default(uuid())

  userId          String
  blingCompanyId  String?
  b2bCompanyErpId String

  name            String
  cnpj            String?
  active          Boolean  @default(true)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  blingCompany    BlingCompany? @relation(fields: [blingCompanyId], references: [blingCompanyId])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, b2bCompanyErpId])
  @@index([userId])
  @@index([blingCompanyId])
  @@map("companies")
}
